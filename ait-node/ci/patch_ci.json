{
  "schema_version": 1,
  "suites": [
    {
      "schema_version": 1,
      "suite_id": "node_unit",
      "display_name": "Node Unit",
      "plane": "patchset",
      "default_blocking": true,
      "mode": "gate",
      "purpose": "Validate the language-neutral npm CLI package, clean installation, and native command behavior before remote land.",
      "runner": {
        "kind": "command_bundle",
        "commands": [
          "./ci/run.sh patchset"
        ]
      },
      "artifacts": {
        "log_path": ".ait/generated/ci/node_unit.log"
      }
    }
  ]
}
