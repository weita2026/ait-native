      "repository_index": 1,
      "namespace": "SE"
    },
    {
      "repo_name": "ait-python",
      "repository_index": 2,
      "namespace": "P"
    },
    {
      "repo_name": "ait-node",
      "repository_index": 3,
      "namespace": "N"
    },
    {
      "repo_name": "ait-runner",
      "repository_index": 4,
      "namespace": "R"
    }
  ],
  "portable_runner": {
    "target": "portable",
    "runner": "macos-15",
    "os": "macos",
    "architecture": "arm64",
    "minimum_platform_kind": "portable_envelope",
    "minimum_platform": "n/a",
    "executable_suffix": ""
  }
