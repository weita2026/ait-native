{
  "schema": "ait.release.adapter/v1",
  "package": {
    "name": "ait-python",
    "version": "1.1.0",
    "description": "Apache-2.0 abi3 wheels for the Rust-owned AIT Python binding",
    "license_files": [
      {
        "path": "LICENSE",
        "role": "license"
      },
      {
        "path": "NOTICE",
        "role": "notice"
      }
    ]
  },
  "components": [
    {
      "id": "ait-python",
      "ecosystem": "python",
      "working_directory": ".",
      "dependency_files": [
        ".cargo/config.toml",
        "pyproject.toml",
        "ait-external.toml",
        "ait-external.lock",
        "release/release_adapter.py"
      ],
      "commands": {
        "test": [
          [
            "python",
            "release/release_adapter.py",
            "check",
            "$AIT_RELEASE_TARGET",
            "$AIT_RELEASE_VERSION"
          ]
        ],
        "build": [
          [
            "python",
            "release/release_adapter.py",
            "build",
            "$AIT_RELEASE_TARGET",
            "$AIT_RELEASE_VERSION"
          ]
        ],
        "smoke": [
          [
            "python",
            "release/release_adapter.py",
            "smoke",
            "$AIT_RELEASE_TARGET",
            "$AIT_RELEASE_VERSION"
          ]
        ]
      },
      "artifacts": [
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-macosx_11_0_arm64.whl",
          "kind": "python-wheel",
          "target": "aarch64-apple-darwin"
        },
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-macosx_10_12_x86_64.whl",
          "kind": "python-wheel",
          "target": "x86_64-apple-darwin"
        },
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-manylinux_2_28_aarch64.whl",
          "kind": "python-wheel",
          "target": "aarch64-unknown-linux-gnu"
        },
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-manylinux_2_28_x86_64.whl",
          "kind": "python-wheel",
          "target": "x86_64-unknown-linux-gnu"
        },
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-win_arm64.whl",
          "kind": "python-wheel",
          "target": "aarch64-pc-windows-msvc"
        },
        {
          "path": "dist/wheels/ait_python-1.1.0-cp311-abi3-win_amd64.whl",
          "kind": "python-wheel",
          "target": "x86_64-pc-windows-msvc"
        }
      ]
    }
  ]
}
