{
  "schema_version": 1,
  "suites": [
    {
      "suite_id": "rust_core",
      "display_name": "Rust Patchset Gate (Bounded)",
      "plane": "patchset",
      "default_blocking": true,
      "mode": "gate",
      "purpose": "Run the bounded ait-server core/server library and seam contract gate before remote land; full workspace validation belongs to repo/all CI.",
      "runner": {
        "kind": "test_discovery_sharded",
        "adapter": "cargo",
        "manifest_path": "rust/Cargo.toml",
        "workspace": false,
        "doc_tests": false,
        "build_args": [
          "test",
          "--locked",
          "--profile",
          "ait-ci",
          "--no-run",
          "-p",
          "ait-server-core",
          "-p",
          "ait-server",
          "--lib",
          "--test",
          "seam_contract_direct_tests",
          "--features",
          "ait-server-core/patch-ci-harness",
          "--message-format=json"
        ],
        "checks": [
          {
            "kind": "forbid_files",
            "check_id": "no_python_boundary",
            "file_name_suffix": ".py",
            "exclude_dirs": [
              ".git",
              ".ait",
              ".cargo",
              "target"
            ]
          }
        ]
      },
      "artifacts": {
        "log_path": ".ait/generated/ci/rust_core.log"
      }
    }
  ]
}
